{
  "name": "bangla24-news-portal",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "scripts": {
    "predev": "node scripts/build-reader-guides.mjs",
    "dev": "next dev",
    "lint": "eslint . --max-warnings=0",
    "pretypecheck": "node scripts/build-reader-guides.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "prebuild": "node --test scripts/build-reader-guides.test.mjs && node scripts/build-reader-guides.mjs",
    "build": "npm run lint && next build --webpack",
    "start": "next start"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "postcss": "8.5.23",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  }
}
